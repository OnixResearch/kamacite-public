<kamacite-preserves-schema-artifact-v1 {
  family: "target-artifact"
  version: "v1"
  schema-id: "kamacite.target-artifact.v1"
  record-label: "kamacite-target-artifact-v1"
  fields: ["schema-version" "target-kind" "producer-identity" "input-identities" "output-artifact-identity" "target-metadata" "reproducibility-limits" "non-claims"]
