<kamacite-fsm-spec-v2 1 "fixture.adapter-modes" <None> [<FsmStateInput "stored" "Stored evidence">, <FsmStateInput "execution" "Execution admitted">, <FsmStateInput "denied" "Denied">] [<FsmEventInput "use-stored" "Use stored evidence">, <FsmEventInput "request-execution" "Request explicit execution">, <FsmEventInput "undeclared-effect" "Undeclared effect">] "stored" [] ["denied"] "deterministic" "all-state-event-pairs-explicit" [<FsmGuardInput "capability-admitted" ["adapter-capability"] ["capability evidence is not ambient authority"]>] [<FsmSideEffectInput "none" "no-side-effect">, <FsmSideEffectInput "explicit-shell" "symbolic">] [<FsmTransitionRowInput "stored" "use-stored" "stored" [] "none">, <FsmTransitionRowInput "stored" "request-execution" "execution" ["capability-admitted"] "explicit-shell">, <FsmTransitionRowInput "execution" "use-stored" "stored" [] "none">, <FsmTransitionRowInput "execution" "request-execution" "execution" ["capability-admitted"] "explicit-shell">] [<FsmDenialRowInput "stored" "undeclared-effect" "undeclared-effect" [] "none" #t>, <FsmDenialRowInput "execution" "undeclared-effect" "undeclared-effect" [] "none" #t>, <FsmDenialRowInput "denied" "use-stored" "denied-state" [] "none" #t>, <FsmDenialRowInput "denied" "request-execution" "denied-state" [] "none" #t>, <FsmDenialRowInput "denied" "undeclared-effect" "denied-state" [] "none" #t>] ["adapter-mode-gates-explicit"] ["adapter-mode fixture does not grant evaluator or host authority"]>
