<kamacite-fsm-spec-v2 1 "fixture.lifecycle.terminal-outgoing" <None> [<FsmStateInput "idle" "Idle">, <FsmStateInput "done" "Done">] [<FsmEventInput "finish" "Finish">, <FsmEventInput "reset" "Reset">] "idle" ["done"] [] "deterministic" "all-state-event-pairs-explicit" [] [<FsmSideEffectInput "none" "no-side-effect">, <FsmSideEffectInput "admit" "symbolic">] [<FsmTransitionRowInput "idle" "finish" "done" [] "admit">, <FsmTransitionRowInput "done" "reset" "idle" [] "admit">] [<FsmDenialRowInput "idle" "reset" "not-done" [] "none" #t>, <FsmDenialRowInput "done" "finish" "already-done" [] "none" #t>] ["terminal-outgoing-fails-closed"] ["terminal transitions need explicit accepted restart policy"]>
